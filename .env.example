MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Admin login used only by the init script to create the database and user.
# XAMPP's root user has no password by default; leave it blank unless you set one.
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=

# The app's own login and database (created by the init script).
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=da2410hc4288as23663

# Login sessions. SESSION_SECRET_KEY signs the session cookie: use a long random value.
APP_ENV=development
SESSION_SECRET_KEY=replace_with_a_long_random_secret_key
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE=3600
